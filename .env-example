#---------------------------------------------
# Global
# 所有目录相关的配置，结尾不能有/，windows下会导致挂载的目录没有权限
#---------------------------------------------
TIMEZONE=UTC
# 使用docker宿主机ip，否则xdebug+phpstorm的无法断点
DOCKER_HOST_IP=10.0.0.11
HOST_PROJECT_PATH=/home/user/develop
CONTAINER_PROJECT_PATH=/home/user/develop
DATA_PATH=/data
# HOST_UID/HOST_GID/HOST_USER 需要与宿主机保持一致（不一致可能会导致容器中创建的文件在宿主机中没有写权限），可以使用命令`id`来查看当前用户的详细信息
HOST_UID=1000
HOST_GID=1000
HOST_USER=user

#---------------------------------------------
# MySQL
#---------------------------------------------
# MYSQL_IMAGE=mysql/mysql-server  # for apple m1
MYSQL_IMAGE=mysql
MYSQL_VERSION=5.7
MYSQL_ROOT_PASSWORD=123456
MYSQL_HOST_DATA_PATH=/data/mysql5.7
MYSQL_CONTAINER_DATA_PATH=/var/lib/mysql
MYSQL_DATABASE=default
MYSQL_PORT=3306
MYSQL_ENTRYPOINT_INITDB=./containers/services/mysql/docker-entrypoint-initdb.d
MYSQL_USER=docker
MYSQL_PASSWORD=123456

#---------------------------------------------
# PostgreSQL
#---------------------------------------------
POSTGRES_VERSION=13.22
POSTGRES_PORT=5432
POSTGRES_HOST_DATA_PATH=/data/postgres-13.22
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=postgres
PGADMIN_PORT=5050
#---------------------------------------------
# Ubuntu (kubectl)
#---------------------------------------------
# UBUNTU_VERSION=20.04
UBUNTU_VERSION=22.04

#---------------------------------------------
# PHP-fpm
#---------------------------------------------
PHP_VERSION=8.2
PHP_FPM_PORT=9000
PHP_INSTALL_COMPOSER=true
PHP_INSTALL_XDEBUG=true
PHP_INSTALL_REDIS=false
PHP_INSTALL_JIEBA=false
PHP_INSTALL_SWOOLE=false
PHP_INSTALL_IMAGICK=false
PHP_IMAGICK_VERSION=latest
PHP_INSTALL_PHALCON=false
PHP_PHALCON_VERSION=4.0.5

#---------------------------------------------
# Nginx
#---------------------------------------------
NGINX_VERSION=1.28.0
LINK_FPM=false

#---------------------------------------------
# Redis
#---------------------------------------------
REDIS_VERSION=7.4.5
REDIS_HOST_DATA_PATH=/data/redis-7.4.5
REDIS_CONTAINER_DATA_PATH=/data
REDIS_PORT=6379

#---------------------------------------------
# JDK
#---------------------------------------------
JDK_VERSION=17
JDK_HOST_MAVEN_PATH=./containers/languages/java/maven-3.6.3
JDK_HOST_GRADLE_PATH=./containers/languages/java/gradle-6.0.1
JDK_HOST_JAVAFX_PATH=./containers/languages/java/javafx-11.0.2

#---------------------------------------------
# NODE
#---------------------------------------------
# NODE_VERSION=10.24.1
#NODE_VERSION=12.22.12
#NODE_VERSION=14.21.3
#NODE_VERSION=16.20.2
# NODE_VERSION=17.9.1
#NODE_VERSION=18.20.8
#NODE_VERSION=20.19.5
NODE_VERSION=22.18.0
#PNPM_VERSION=5.18.11
#PNPM_VERSION=8.15.9
#PNPM_VERSION=9.15.9
PNPM_VERSION=10.18.2

#---------------------------------------------
# MONGO
#---------------------------------------------
MONGO_VERSION=latest
MONGO_CONTAINER_DATA_DIR=/data/db
MONGO_HOST_DATA_DIR=/data/mongo
MONGO_CONTAINER_LOG_DIR=/data/log
MONGO_HOST_LOG_DIR=./containers/services/mongo/log
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=123456
MONGO_PORT=27017

#---------------------------------------------
# Kubectl
#---------------------------------------------
KUBECTL_VERSION=1.34.1

#---------------------------------------------
# Rust
#---------------------------------------------
RUST_VERSION=1.83

#---------------------------------------------
# LiteLLM AI Gateway
#---------------------------------------------
DEEPSEEK_API_KEY=
QWEN_API_KEY=

#---------------------------------------------
# Hermes Agent
#---------------------------------------------
HERMES_VERSION=v2026.6.5
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD=1
HERMES_HOST_DATA_PATH=/data/hermes
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

#---------------------------------------------
# DBX
#---------------------------------------------
DBX_MEM_LIMIT=512m
DBX_DISABLE_PASSWORD=1
DBX_WEB_PORT=4224

#---------------------------------------------
# RabbitMQ
#---------------------------------------------
RABBITMQ_VERSION=3.13
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=docker
RABBITMQ_DEFAULT_PASS=<your-password>
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_HOST_DATA_PATH=/data/rabbitmq-3.13
RABBITMQ_CONTAINER_DATA_PATH=/var/lib/rabbitmq

#---------------------------------------------
# RocketMQ
#---------------------------------------------
ROCKETMQ_VERSION=4.7.1
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_HOST_DATA_PATH=/data/rocketmq-4.7.1/store
ROCKETMQ_HOST_LOG_PATH=/data/rocketmq-4.7.1/logs
ROCKETMQ_NAMESRV_MEM_LIMIT=384m
ROCKETMQ_BROKER_MEM_LIMIT=768m
