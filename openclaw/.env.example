# OpenClaw Docker 环境变量
# 复制为 .env 并修改：cp .env.example .env

# 配置目录（挂载到容器内 /home/node/.openclaw，含 workspace、extensions 等）
OPENCLAW_CONFIG_DIR=/home/xuqinqin/develop/docker/openclaw/config

# Gateway 端口
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# 绑定模式：loopback(仅本机) / lan(局域网)
OPENCLAW_GATEWAY_BIND=loopback

# Gateway Token（从 openclaw gateway install 生成，或从 ~/.openclaw/openclaw.json 的 gateway.auth.token 获取）
OPENCLAW_GATEWAY_TOKEN=你的token
