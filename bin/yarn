#!/bin/bash
if [[ "$PWD" == /home/docker/.dsh* ]]; then
  if [ -x /usr/local/bin/yarn ]; then
    exec /usr/local/bin/yarn "$@"
  fi
  echo "[bin/yarn] 错误：dsh 数据根语境未找到 /usr/local/bin/yarn" >&2
  exit 1
fi
cleanup() {
    docker exec node pkill -TERM -f "yarn $*" 2>/dev/null
}
trap cleanup INT TERM HUP
docker-run node yarn "$@"
